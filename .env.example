# Copy to .env and fill in. Loaded by ragongcp.config.Settings.

# --- Google Cloud ---
RAGONGCP_PROJECT_ID=your-gcp-project-id
RAGONGCP_LOCATION=us-central1

# --- Use-case profile (selects config/<profile>.yaml) ---
RAGONGCP_PROFILE=bc_real_estate

# --- Backend override (optional; default comes from the profile yaml) ---
# One of: vertex_rag_engine | vertex_search | custom_vector | fake
# RAGONGCP_BACKEND=vertex_rag_engine

# --- Staging bucket for ingested documents (GCS) ---
RAGONGCP_STAGING_BUCKET=your-staging-bucket

# --- Local dev: use the in-memory fake backend so no GCP creds are needed ---
# RAGONGCP_BACKEND=fake

# --- Optional FinOps/cost tracking ---
# Keep disabled unless you want per-request cost telemetry.
# RAGONGCP_COST_TRACKING_ENABLED=false
# RAGONGCP_COST_TRACKING_SINK=log         # log | bigquery
# RAGONGCP_COST_TRACKING_BQ_DATASET=finops
# RAGONGCP_COST_TRACKING_BQ_TABLE=rag_cost_events
